# Kopieren nach .env und Passwort setzen.

POSTGRES_USER=pm
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=pm

# Externe Origin, unter der die App erreichbar ist (Caddy).
APP_ORIGIN=https://pm.localhost

# Zeitzone der App. Geplante Termine werden als Ortszeit eingegeben.
TZ=Europe/Berlin

# Zweiter Ablageort fuer Sicherungen, ausserhalb der WSL. Ohne den liegt die
# Sicherung auf derselben Platte wie die Daten und schuetzt nur gegen
# Fehlbedienung, nicht gegen Verlust. Pfad unter /mnt/c, moeglichst in einen
# Ordner, der vom Rechner weg synchronisiert wird.
# BACKUP_MIRROR=/mnt/c/Users/DEINNAME/OneDrive/projektmanager-backups

# Nur fuer lokale Entwicklung ausserhalb von Docker (npm run dev):
# DATABASE_URL=postgresql://pm:bitte-aendern@localhost:5432/pm?schema=public
# UPLOAD_DIR=./uploads
